# Environment
NODE_ENV=development

# Public URL of the site (used by Better Auth for OAuth redirects).
# Local: http://localhost:4200 — Production: your Render URL, e.g. https://vanator.onrender.com
WEBSITE_URL=http://localhost:4200

# Better Auth — secret used to sign sessions. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Database (Turso / libSQL) — create a free DB at https://turso.tech
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Google login (optional) — create OAuth credentials in Google Cloud Console.
# Authorized redirect URI: <WEBSITE_URL>/api/auth/callback/google
# Leave empty to keep only email/password sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
